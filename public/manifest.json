{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "https://mashedstreaks.pages.dev/",
  "name": "Mashed Personal Dashboard",
  "short_name": "Mashed Plan",
  "description": "Seamlessly connect your habits, to-dos, and time tracking in one powerful app.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#000000",
  "theme_color": "#000000",
  "categories": ["productivity", "utilities"],
  "prefer_related_applications": false,
  "related_applications": [],
  "display_override": ["standalone"],
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Home",
      "description": "Open today's personal dashboard",
      "url": "/dashboard",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Streaks",
      "short_name": "Streaks",
      "description": "Track habits and streaks",
      "url": "/streaks",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Todos",
      "short_name": "Todos",
      "description": "Open your to-do list",
      "url": "/todos",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Timesheet",
      "short_name": "Time",
      "description": "Log time and review workspaces",
      "url": "/timesheet",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/narrow-1080x1920.png",
      "sizes": "1290x2796",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Dashboard on a phone"
    },
    {
      "src": "/screenshots/wide-1920x1080.png",
      "sizes": "2796x1290",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Dashboard on desktop"
    }
  ]
}
